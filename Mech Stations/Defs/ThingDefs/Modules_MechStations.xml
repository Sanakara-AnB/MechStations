<?xml version="1.0" encoding="utf-8"?>
<Defs>


    <!-- ==================================================================== -->
    <!-- STATION MODULES                                                      -->
    <!--                                                                      -->
    <!-- Shared base holds everything the modules have in common.             -->
    <!-- Ownership is geometry, not links: The station's own front side is    -->
    <!-- blocked by its (disfuntional) interaction cell, so at most three     -->
    <!-- modules fit around a 3x3 port, with separate limitation by    	      -->  	     	     
    <!-- <maxPerStation>.						      -->

    <!-- Without <designationCategory>, placing Modules outside god mode      -->
    <!-- throws in GenSpawn.WipeExistingThings (MissingRoot Red Error).	      -->
    <!-- DMS modules override this in ther own Defs below.		      -->

    <!--  Offsets with Gizmo to compensate Mech offsets                       -->
    <!--  "<li Class="MechStations.MSCompProperties_ExtraRenderer">"          -->
    <!--    <positionPresets>						      -->
    <!--      <li>(0, 0, 0)</li>					      -->
    <!--      <li>(0, 0, -0.25)</li>					      -->
    <!--      <li>(0, 0, -0.5)</li>					      -->
    <!--    </positionPresets>						      -->

    <!--  Layers: no <drawOffset> on any BASE graphic. Everything sits at     -->
    <!--  plain 'Building' height like vanilla furniture, so overlap between  -->
    <!--  buildings is decided by POSITION - the print tilt lets the          -->
    <!--  southern one win, pixel by pixel. A base offset of 0.01 or more     -->
    <!--  kills that and beats vanilla walls and beds wherever they stand.    -->
    <!--                                                                      -->
    <!--  A _top over its OWN base needs a minimal value: print order         -->
    <!--  already sorts it, but at equal height the depth test can override   -->
    <!--  and the top vanishes. A _top over a FOREIGN building - a module     -->
    <!--  arm over its port - needs a large one: print order cannot reach     -->
    <!--  across two things, and small values fail because a different        -->
    <!--  drawSize tilts at a different steepness. Such a top beats           -->
    <!--  southern furniture too, accepted for a raised part.                 -->

    <!--  Defaults:                                                           -->
    <!--  Port tops:.........0.001  (clears its own base only)                -->
    <!--  Module tops:.......0.08   (drawn over all layers)                   -->
    <!--  "Lights" (mask):...0.075  (Code)     			              -->
    <!--  Waste Bar:.........0.10   (Code)				      -->
    <!-- ==================================================================== -->


  <ThingDef Name="MSModuleBase" ParentName="BuildingBase" Abstract="True">

    <thingClass>MechStations.MSBuilding_StationModule</thingClass>
    <category>Building</category>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>0</pathCost>
    <fillPercent>0.4</fillPercent>
    <size>(3,1)</size>
    <rotatable>true</rotatable>
    <defaultPlacingRot>North</defaultPlacingRot>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

    <designationCategory>Biotech</designationCategory>

    <statBases>
      <Flammability>0</Flammability>
      <Beauty>-1</Beauty>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>500</WorkToBuild>
    </statBases>

    <building>
      <ai_chillDestination>false</ai_chillDestination>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
      <paintable>true</paintable>
    </building>

    <drawerType>MapMeshAndRealTime</drawerType>

    <!-- Rare is a safety net, not a work cycle: the station pushes each module
         its power state while scanning its ring. Nothing here needs Normal -
         CompPowerTrader and CompFlickable have no tick method at all. -->
    <tickerType>Rare</tickerType>

    <placeWorkers>
      <li>MechStations.MSPlaceWorker_ModuleAlignment</li>
    </placeWorkers>

    <comps>

      <li Class="MechStations.MSCompProperties_StatusLight"></li>

    </comps>

  </ThingDef>

    <!-- ===== NOTES =============================================================== -->
    <!-- No <chargeStages> here: modules read state, thresholds and colors from      -->
    <!-- their port. To give a module different MASK colors, add                     -->
    <!-- <li Class="MechStations.MSCompProperties_LightOverride"> to its comps.      -->
    <!-- State and colors come from the port this module faces. 		     -->
    <!-- <suppressIdleMask> Turns off the texture light while idle. 		     -->
    <!-- =========================================================================== -->


