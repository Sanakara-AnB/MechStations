  <!-- =====> MECH CHARGE ACCELERATOR MODULE (1x3) <===== -->
  <!-- ================================================== -->

  <ThingDef ParentName="MSModuleBase">
    <defName>MS_ChargeModule_Large</defName>
    <label>charge accelerator module</label>
    <description>Attaches to a mech port and speeds up its charging. Several can be fitted to one port, but each costs additional power while the port is actually charging.</description>

    <researchPrerequisites>
      <li>StandardMechtech</li>
    </researchPrerequisites>

    <costList>
      <Steel>60</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
    </costList>

    <graphicData>
      <texPath>Things/Building/MechModules/MechModulesL/MechAcceleratorL/MechAcceleratorL</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3.7, 3.7)</drawSize>
    </graphicData>

    <comps>

      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>150</basePowerConsumption>
        <idlePowerDraw>10</idlePowerDraw>
      </li>

      <li Class="MechStations.MSCompProperties_ChargeModule">
        <chargeRateBonus>0.15</chargeRateBonus>
      </li>

      <li Class="CompProperties_Flickable"/>

      <li Class="MechStations.MSCompProperties_ExtraRenderer">
        <positionPresets>
          <li>(0, 0, 0)</li>
          <li>(0, 0, -0.25)</li>
          <li>(0, 0, -0.5)</li>
        </positionPresets>
      </li>

      <li Class="MechStations.MSCompProperties_LightOverride">
        <suppressIdleMask>true</suppressIdleMask>
      </li>

    </comps>
  </ThingDef>


