<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- ==================================================================== -->
  <!-- GLITTERWORLD DESTROYER 5 - ThinkTreeDef "MechMosquito"               -->
  <!--                                                                      -->
  <!-- A full copy of the vanilla Mechanoid tree, made for its own combat    -->
  <!-- subtrees - the charging part was carried over unchanged, which is why -->
  <!-- the paths below match vanilla's. Each operation sits in its OWN       -->
  <!-- sequence with success=Always, so a future update that reshapes the    -->
  <!-- tree costs only that one insertion instead of the whole file.         -->
  <!-- ==================================================================== -->

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>
          /Defs/ThinkTreeDef[defName="MechMosquito"]
            /thinkRoot/subNodes
            /li[@Class="ThinkNode_ConditionalPlayerControlledMech"][not(invert) and not(@invert)]
            /subNodes
            /li[@Class="ThinkNode_ConditionalNotFormingCaravan"]
            /subNodes
        </xpath>
        <order>Append</order>
        <value>
          <li Class="ThinkNode_ConditionalWorkMode" MayRequire="Ludeon.RimWorld.Biotech">
            <workMode>MS_Docking</workMode>
            <subNodes>
              <li Class="JobGiver_SeekAllowedArea" />
              <li Class="MechStations.MSJobGiver_DockingMode" />
              <li Class="JobGiver_GetEnergy_Charger" />
              <li Class="JobGiver_GetEnergy_SelfShutdown">
                <forced>true</forced>
              </li>
            </subNodes>
          </li>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>
          /Defs/ThinkTreeDef[defName="MechMosquito"]
            /thinkRoot/subNodes
            /li[@Class="ThinkNode_ConditionalPlayerControlledMech"][not(invert) and not(@invert)]
            /subNodes
            /li[@Class="ThinkNode_ConditionalNotFormingCaravan"]
            /subNodes
            /li[@Class="ThinkNode_ConditionalWorkMode"][workMode="Work"]
            /subNodes
            /li[@Class="ThinkNode_ConditionalWorkMech"][invert="true"]
            /subNodes
            /li[@Class="ThinkNode_Tagger"]
            /subNodes
        </xpath>
        <order>Prepend</order>
        <value>
          <li Class="MechStations.MSJobGiver_DockingReturn"/>
        </value>
      </li>
    </operations>
  </Operation>

  <Operation Class="PatchOperationSequence">
    <success>Always</success>
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>
          /Defs/ThinkTreeDef[defName="MechMosquito"]
            /thinkRoot/subNodes
            /li[@Class="ThinkNode_ConditionalPlayerControlledMech"][not(invert) and not(@invert)]
            /subNodes
            /li[@Class="ThinkNode_Tagger"]
            /subNodes
        </xpath>
        <order>Prepend</order>
        <value>
          <li Class="MechStations.MSJobGiver_DockingReturn"/>
        </value>
      </li>
    </operations>
  </Operation>

</Patch>
