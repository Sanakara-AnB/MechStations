# Build output. Regenerated by every build, never edited by hand.
bin/
obj/

# Visual Studio local state: window layout, caches, per-user settings.
.vs/
*.user
*.suo

# Windows / OneDrive folder metadata.
desktop.ini
Thumbs.db

# NOTE: "Mech Stations/Assemblies/MechStations.dll" is tracked ON PURPOSE.
# That folder is the shipped mod - a checked-out state has to be playable
# without a build step. Copy the DLL there after every build.
